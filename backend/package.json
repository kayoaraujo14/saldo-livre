{
  "name": "saldo-livre-backend",
  "version": "1.0.0",
  "description": "Backend Serverless & Cloud Functions para Saldo Livre",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "test": "vitest run --dir .",
    "watch": "tsc -w",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0",
    "firebase-functions": "^5.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "typescript": "^5.6.3",
    "vitest": "^3.0.0"
  },
  "private": true
}
