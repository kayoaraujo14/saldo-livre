rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: /users/{userId}
    // Document ID: userId (Auth UID)
    // Fields:
    //   - uid: string (required) - UID do usuário
    //   - email: string (required) - Email para busca de contatos
    //   - displayName: string (optional) - Nome de exibição
    //   - photoURL: string (optional) - URL do avatar
    //   - monthlyIncome: number (optional) - Renda mensal base
    //
    // Subcollections:
    //   - /users/{userId}/activity_logs/{logId} (Logs de auditoria e atividades privadas)
    //   - /users/{userId}/agent_rules/{ruleId} (Regras aprendidas pelo Copiloto IA)
    //   - /users/{userId}/chat_sessions/{sessionId} (Histórico de conversas com IA)
    //   - /users/{userId}/month_closures/{closureId} (Fechamentos mensais e repasse de saldo)
    //
    // Collection: /friendships/{friendshipId}
    // Fields:
    //   - requesterUid: string (required, immutable) - UID do solicitante
    //   - recipientUid: string (required, immutable) - UID do destinatário
    //   - requesterEmail: string (optional)
    //   - requesterName: string (optional)
    //   - recipientEmail: string (optional)
    //   - recipientName: string (optional)
    //   - status: string (pending | accepted | rejected)
    //   - createdAt: number (optional)
    //   - updatedAt: number (optional)
    //
    // Collection: /cards/{cardId}
    // Fields:
    //   - ownerUid: string (required, immutable) - UID do titular do cartão
    //   - cardName: string (required)
    //   - closingDay: number (optional)
    //   - dueDay: number (optional)
    //   - limit: number (optional)
    //   - sharedWithUids: list (optional) - UIDs autorizados para visualização
    //
    // Collection: /recurring_bills/{billId}
    // Fields:
    //   - ownerUid: string (required, immutable) - UID do proprietário
    //   - description: string (required)
    //   - amount: number (required)
    //   - category: string (optional)
    //   - active: bool (optional)
    //
    // Collection: /transactions/{txId}
    // Fields:
    //   - createdByUid: string (required/optional, immutable) - Criador original
    //   - paidByUid: string (optional) - Pagador da despesa
    //   - visibleToUids: list (required) - UIDs com permissão de leitura
    //   - assignedFriendUid: string (optional) - Amigo atribuído para rateio
    //   - acceptanceStatus: string (optional: pending | accepted | rejected)
    //   - respondedAt: number (optional)
    //   - cardId: string (optional)
    //   - totalAmount: number (optional)
    //   - description: string (optional)
    //
    // Top-Level Legacy/Migration Fallbacks:
    //   - /agent_rules/{ruleId} (ownerUid: string, immutable)
    //   - /chat_sessions/{sessionId} (ownerUid: string, immutable)
    //   - /month_closures/{closureId} (uid: string, immutable)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isTxParticipant(data) {
      return data != null && (
        (('visibleToUids' in data) && data.visibleToUids is list && request.auth.uid in data.visibleToUids) ||
        (('assignedFriendUid' in data) && data.assignedFriendUid == request.auth.uid) ||
        (('createdByUid' in data) && data.createdByUid == request.auth.uid) ||
        (('paidByUid' in data) && data.paidByUid == request.auth.uid)
      );
    }

    function isTxSharedCardHolder(data) {
      return data != null &&
             ('cardId' in data) &&
             data.cardId != null &&
             data.cardId is string &&
             data.cardId != '' &&
             exists(/databases/$(database)/documents/cards/$(data.cardId)) &&
             ('sharedWithUids' in get(/databases/$(database)/documents/cards/$(data.cardId)).data) &&
             get(/databases/$(database)/documents/cards/$(data.cardId)).data.sharedWithUids is list &&
             request.auth.uid in get(/databases/$(database)/documents/cards/$(data.cardId)).data.sharedWithUids;
    }

    function isTxCreator(data) {
      return data != null && (
        (('createdByUid' in data) && data.createdByUid == request.auth.uid) ||
        ((!('createdByUid' in data) || data.createdByUid == null) && ('paidByUid' in data) && data.paidByUid == request.auth.uid)
      );
    }

    // ===============================================================
    // Regras de Segurança por Coleção
    // ===============================================================

    // 1. Perfil do Usuário
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && (!('uid' in request.resource.data) || request.resource.data.uid == userId);
      allow delete: if isOwner(userId);
    }

    // 2. Subcoleções Privadas de Usuário (/users/{userId}/...)
    match /users/{userId}/activity_logs/{logId} {
      allow read, create, update, delete: if isOwner(userId);
    }

    match /users/{userId}/agent_rules/{ruleId} {
      allow read, create, update, delete: if isOwner(userId);
    }

    match /users/{userId}/chat_sessions/{sessionId} {
      allow read, create, update, delete: if isOwner(userId);
    }

    match /users/{userId}/month_closures/{closureId} {
      allow read, create, update, delete: if isOwner(userId);
    }

    // 3. Rede de Amizades (Requester ou Recipient)
    match /friendships/{friendshipId} {
      allow read: if isAuthenticated() &&
        resource != null &&
        ('requesterUid' in resource.data) &&
        ('recipientUid' in resource.data) && (
          resource.data.requesterUid == request.auth.uid ||
          resource.data.recipientUid == request.auth.uid
        );

      allow create: if isAuthenticated() &&
        ('requesterUid' in request.resource.data) &&
        ('recipientUid' in request.resource.data) &&
        request.resource.data.requesterUid == request.auth.uid &&
        request.resource.data.recipientUid != request.auth.uid;

      allow update: if isAuthenticated() &&
        resource != null &&
        ('requesterUid' in resource.data) &&
        ('recipientUid' in resource.data) && (
          resource.data.requesterUid == request.auth.uid ||
          resource.data.recipientUid == request.auth.uid
        ) &&
        ('requesterUid' in request.resource.data) &&
        request.resource.data.requesterUid == resource.data.requesterUid &&
        ('recipientUid' in request.resource.data) &&
        request.resource.data.recipientUid == resource.data.recipientUid;

      allow delete: if isAuthenticated() &&
        resource != null &&
        ('requesterUid' in resource.data) &&
        ('recipientUid' in resource.data) && (
          resource.data.requesterUid == request.auth.uid ||
          resource.data.recipientUid == request.auth.uid
        );
    }

    // 4. Cartões (Titular com controle total, Convidado somente leitura)
    match /cards/{cardId} {
      allow read: if isAuthenticated() &&
        resource != null && (
          (('ownerUid' in resource.data) && resource.data.ownerUid == request.auth.uid) ||
          (('sharedWithUids' in resource.data) && resource.data.sharedWithUids is list && request.auth.uid in resource.data.sharedWithUids)
        );

      allow create: if isAuthenticated() &&
        ('ownerUid' in request.resource.data) &&
        request.resource.data.ownerUid == request.auth.uid;

      allow update: if isAuthenticated() &&
        resource != null &&
        ('ownerUid' in resource.data) &&
        resource.data.ownerUid == request.auth.uid &&
        ('ownerUid' in request.resource.data) &&
        request.resource.data.ownerUid == resource.data.ownerUid;

      allow delete: if isAuthenticated() &&
        resource != null &&
        ('ownerUid' in resource.data) &&
        resource.data.ownerUid == request.auth.uid;
    }

    // 5. Moldes Recorrentes (Apenas o dono acessa)
    match /recurring_bills/{billId} {
      allow read: if isAuthenticated() &&
        resource != null &&
        ('ownerUid' in resource.data) &&
        resource.data.ownerUid == request.auth.uid;

      allow create: if isAuthenticated() &&
        ('ownerUid' in request.resource.data) &&
        request.resource.data.ownerUid == request.auth.uid;

      allow update: if isAuthenticated() &&
        resource != null &&
        ('ownerUid' in resource.data) &&
        resource.data.ownerUid == request.auth.uid &&
        ('ownerUid' in request.resource.data) &&
        request.resource.data.ownerUid == resource.data.ownerUid;

      allow delete: if isAuthenticated() &&
        resource != null &&
        ('ownerUid' in resource.data) &&
        resource.data.ownerUid == request.auth.uid;
    }

    // 6. Transações (Isolamento Estrito de Privacidade e Rateio)
    match /transactions/{txId} {
      allow read: if isAuthenticated() && (
        isTxParticipant(resource.data) ||
        isTxSharedCardHolder(resource.data)
      );

      allow create: if isAuthenticated() && (
        (('visibleToUids' in request.resource.data) && request.resource.data.visibleToUids is list && request.auth.uid in request.resource.data.visibleToUids) ||
        (('createdByUid' in request.resource.data) && request.resource.data.createdByUid == request.auth.uid)
      );

      allow delete: if isAuthenticated() && isTxCreator(resource.data);

      allow update: if isAuthenticated() && resource != null && (
        // Criador ou pagador original tem permissão para alterar os dados da transação, com imutabilidade de createdByUid
        (
          isTxCreator(resource.data) &&
          (!('createdByUid' in resource.data) || request.resource.data.createdByUid == resource.data.createdByUid)
        ) ||
        // Quem recebeu o rateio pode APENAS aceitar ou rejeitar (alterar acceptanceStatus e respondedAt)
        (
          ('assignedFriendUid' in resource.data) &&
          resource.data.assignedFriendUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acceptanceStatus', 'respondedAt'])
        )
      );
    }

    // 7. Coleções Top-Level (Isolamento Estrito com Separação de CRUD)
    // Regras e Memórias do Agente (Top-Level)
    match /agent_rules/{ruleId} {
      allow read: if isAuthenticated() &&
        resource != null &&
        ('ownerUid' in resource.data) &&
        resource.data.ownerUid == request.auth.uid;

      allow create: if isAuthenticated() &&
        ('ownerUid' in request.resource.data) &&
        request.resource.data.ownerUid == request.auth.uid;

      allow update: if isAuthenticated() &&
        resource != null &&
        ('ownerUid' in resource.data) &&
        resource.data.ownerUid == request.auth.uid &&
        ('ownerUid' in request.resource.data) &&
        request.resource.data.ownerUid == resource.data.ownerUid;

      allow delete: if isAuthenticated() &&
        resource != null &&
        ('ownerUid' in resource.data) &&
        resource.data.ownerUid == request.auth.uid;
    }

    // Histórico de Sessões de Chat (Top-Level)
    match /chat_sessions/{sessionId} {
      allow read: if isAuthenticated() &&
        resource != null &&
        ('ownerUid' in resource.data) &&
        resource.data.ownerUid == request.auth.uid;

      allow create: if isAuthenticated() &&
        ('ownerUid' in request.resource.data) &&
        request.resource.data.ownerUid == request.auth.uid;

      allow update: if isAuthenticated() &&
        resource != null &&
        ('ownerUid' in resource.data) &&
        resource.data.ownerUid == request.auth.uid &&
        ('ownerUid' in request.resource.data) &&
        request.resource.data.ownerUid == resource.data.ownerUid;

      allow delete: if isAuthenticated() &&
        resource != null &&
        ('ownerUid' in resource.data) &&
        resource.data.ownerUid == request.auth.uid;
    }

    // Fechamentos de Mês / Month Closures (Top-Level)
    match /month_closures/{closureId} {
      allow read: if isAuthenticated() &&
        resource != null &&
        ('uid' in resource.data) &&
        resource.data.uid == request.auth.uid;

      allow create: if isAuthenticated() &&
        ('uid' in request.resource.data) &&
        request.resource.data.uid == request.auth.uid;

      allow update: if isAuthenticated() &&
        resource != null &&
        ('uid' in resource.data) &&
        resource.data.uid == request.auth.uid &&
        ('uid' in request.resource.data) &&
        request.resource.data.uid == resource.data.uid;

      allow delete: if isAuthenticated() &&
        resource != null &&
        ('uid' in resource.data) &&
        resource.data.uid == request.auth.uid;
    }
  }
}
