rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Perfil do Usuário
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Rede de Amizades (Requester ou Recipient)
    match /friendships/{friendshipId} {
      allow read, update, delete: if request.auth != null && (
        resource.data.requesterUid == request.auth.uid ||
        resource.data.recipientUid == request.auth.uid
      );
      allow create: if request.auth != null && request.resource.data.requesterUid == request.auth.uid;
    }

    // Cartões (Titular ou Usuário Compartilhado)
    match /cards/{cardId} {
      allow read: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        request.auth.uid in resource.data.sharedWithUids
      );
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        request.auth.uid in resource.data.sharedWithUids
      );
    }

    // Moldes Recorrentes (Apenas o dono acessa)
    match /recurring_bills/{billId} {
      allow read, update, delete: if request.auth != null && (resource == null || resource.data.ownerUid == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
    }

    // Transações (Isolamento Estrito de Privacidade)
    match /transactions/{txId} {
      allow read: if request.auth != null && (
        request.auth.uid in resource.data.visibleToUids ||
        resource.data.assignedFriendUid == request.auth.uid ||
        resource.data.createdByUid == request.auth.uid ||
        resource.data.paidByUid == request.auth.uid
      );
      allow create: if request.auth != null && (
        request.auth.uid in request.resource.data.visibleToUids ||
        request.resource.data.createdByUid == request.auth.uid
      );
      allow delete: if request.auth != null && (
        resource.data.createdByUid == request.auth.uid ||
        (resource.data.createdByUid == null && resource.data.paidByUid == request.auth.uid)
      );
      allow update: if request.auth != null && (
        // Criador ou pagador original tem permissão para alterar os dados da transação
        resource.data.createdByUid == request.auth.uid ||
        (resource.data.createdByUid == null && resource.data.paidByUid == request.auth.uid) ||
        // Quem recebeu o rateio pode APENAS aceitar ou rejeitar (alterar acceptanceStatus e respondedAt)
        (
          resource.data.assignedFriendUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acceptanceStatus', 'respondedAt'])
        )
      );
    }

    // Regras e Memórias do Agente (Por Usuário)
    match /users/{userId}/agent_rules/{ruleId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /agent_rules/{ruleId} {
      allow read, write: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        request.resource.data.ownerUid == request.auth.uid
      );
    }

    // Histórico de Sessões de Chat e Conversas do Copiloto (Por Usuário)
    match /users/{userId}/chat_sessions/{sessionId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /chat_sessions/{sessionId} {
      allow read, write: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        request.resource.data.ownerUid == request.auth.uid
      );
    }

    // Fechamentos de Mês / Month Closures (Por Usuário e Top-Level)
    match /users/{userId}/month_closures/{closureId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /month_closures/{closureId} {
      allow read, write: if request.auth != null && (
        resource.data.uid == request.auth.uid ||
        request.resource.data.uid == request.auth.uid
      );
    }
  }
}

